{
  "name": "d3-creator",
  "version": "0.1.0",
  "description": "Login-free social analytics — D3 Creator",
  "main": "index.js",
  "license": "AGPL-3.0",
  "keywords": [],
  "author": "",
  "engines": {
    "node": ">=22.12.0 <25.0.0"
  },
  "packageManager": "pnpm@10.6.1",
  "scripts": {
    "dev": "pnpm --filter ./apps/frontend run dev",
    "build": "pnpm --filter ./apps/frontend run build",
    "lint": "pnpm --filter ./apps/frontend run lint",
    "build:frontend": "rm -rf apps/frontend/dist && pnpm --filter ./apps/frontend run build",
    "dev:frontend": "rm -rf apps/frontend/dist && pnpm --filter ./apps/frontend run dev",
    "start:prod:frontend": "pnpm --filter ./apps/frontend run start",
    "supabase": "supabase",
    "test": "jest --coverage --detectOpenHandles --reporters=default --reporters=jest-junit",
    "typecheck": "pnpm --filter ./apps/frontend exec tsc --noEmit"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.45.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "clsx": "^2.1.0",
    "dotenv-cli": "^8.0.0",
    "framer-motion": "^12.40.0",
    "gsap": "^3.13.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.11",
    "postprocessing": "^6.36.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-use-cookie": "^1.6.1",
    "sass": "^1.89.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "3.4.17",
    "three": "^0.167.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/jest": "29.5.12",
    "@types/node": "^22.12.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "autoprefixer": "^10.4.17",
    "babel-jest": "29.7.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-environment-node": "^29.4.1",
    "jest-junit": "^16.0.0",
    "postcss": "8.5.23",
    "prettier": "^2.6.2",
    "sharp": "^0.33.4",
    "supabase": "^2.101.0",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.2",
    "tsx": "^4.22.3",
    "typescript": "5.5.4"
  },
  "volta": {
    "node": "22.12.0"
  },
  "jest-junit": {
    "outputDirectory": "./reports",
    "outputName": "junit.xml"
  },
  "pnpm": {
    "overrides": {
      "next": "16.2.11",
      "react": "19.2.4",
      "react-dom": "19.2.4",
      "@types/react": "19.1.8",
      "@types/react-dom": "19.1.6",
      "postcss": "8.5.23"
    }
  }
}
