# D3 Creator — environment configuration
# Copy to .env (or .env.local for frontend) and fill in real values.

# === Supabase ===
# Public — safe to expose to browser
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
# Private — server only, never expose to browser
# Get from: https://supabase.com/dashboard/project/<your-project-ref>/settings/api
SUPABASE_SERVICE_ROLE_KEY=""
# Optional server-only alias for the project URL. getSupabaseAdmin() reads it
# ONLY as the fallback when NEXT_PUBLIC_SUPABASE_URL is unset — leaving it
# blank is fine whenever NEXT_PUBLIC_SUPABASE_URL is set.
# SUPABASE_URL="https://your-project-ref.supabase.co"

# === Admin bootstrap ===
# Admins are determined by the public.admin_email table (NOT a Next.js env var).
# Add an admin with:
#   insert into public.admin_email (email, note) values ('you@d3.com', 'project owner');
# Any future signup with that email is auto-promoted to role='admin' by the trigger.
# To promote an EXISTING user manually:
#   update public.user_role set role = 'admin'
#     where user_id = (select id from auth.users where email = 'you@d3.com');

# === Bright Data (Web Scraper API for Facebook) ===
# Used by libraries/scrapers/facebook adapter against https://api.brightdata.com/datasets/v3
# Datasets: gd_mf124a0511bauquyow (Pages and Profiles) + gd_lkaxegm826bjpoo9m5 (Pages Posts)
# Get from: https://brightdata.com/cp/setting/users
BRIGHTDATA_API_KEY=""
# Optional override (default: https://api.brightdata.com/datasets/v3)
# BRIGHTDATA_API_BASE=""

# === Vercel Cron (production only) ===
# Random secret used to authenticate Vercel Cron requests.
# REQUIRED in production. Unset fails loudly, not silently: all four readers
# (/api/cron/daily-snapshot, /api/cron/archive-and-purge, /api/admin/cron-health,
# /api/admin/backfill-media) refuse the request with a 500; daily-snapshot and
# cron-health also log it. The scheduled scrapes then simply stop, so nothing
# collects until it is set.
# Generate with: openssl rand -base64 32
CRON_SECRET=generate_with_openssl_rand_-base64_32

# === TikHub (REST API for TikTok / Instagram / Douyin / Xiaohongshu) ===
# Used by:
#   - libraries/scrapers (production REST calls to https://api.tikhub.io)
#   - .mcp.json (dev-time MCP servers at https://mcp.tikhub.io/*)
# Get from: https://tikhub.io
TIKHUB_API_KEY=""
# Optional override for mainland-CN routing (default: https://api.tikhub.io)
# TIKHUB_API_BASE="https://api.tikhub.dev"

# === Upstash (rate limiter for /api/proxy-image) ===
# Required in production for proxy-image rate limit.
# Without these the proxy-image route has no per-IP rate limiting — abuse risk.
# Optional in local dev (whitelist + content-type guard still apply when unset).
# When set, the route enforces a sliding window of 30 req per IP per 10s.
#
# Production: install the Upstash Redis integration from the Vercel
# Marketplace — it auto-injects both vars below into the project.
#   https://vercel.com/marketplace/upstash
# Local dev: copy them from the Upstash dashboard if you want to exercise
# the limiter locally; otherwise leave blank.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === OpenRouter (shared by the Video Analyzer and the Script Coach) ===
# PRD 1 §8.3 and PRD 2 §10A.2 own every value, default and constraint here.
# A commented-out line is an optional variable. Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Optional API root override (default: https://openrouter.ai/api/v1) — blank is fine.
# OPENROUTER_API_BASE=""
# Optional attribution — sent as the HTTP-Referer header, omitted when blank.
# OPENROUTER_SITE_URL="https://www.d3creator.com"
# Optional attribution — sent as the X-Title and X-OpenRouter-Title headers,
# both omitted when blank.
# OPENROUTER_APP_TITLE="D3 Creator"
# REQUIRED for the analyzer worker: a pinned model id. Blank makes every job
# fail at model_failed, and GET /api/health reports models_configured: false.
ANALYZER_MODEL=""
TRANSCRIBE_MODEL="openai/whisper-large-v3"
# REQUIRED in production. Blank here — or simply absent from the Vercel project
# env — makes EVERY /api/chat request return 500. The real cause is logged
# server-side; the caller only ever sees a generic "internal error".
CHAT_MODEL=""
# Optional USD→MYR rate for the apps/analyzer cost-measure script
# (default: 4.25) — blank is fine.
# USD_MYR_RATE=""

# === Video Analyzer worker (apps/analyzer) — PRD 1 §8.8.1 owns every rule ===
ANALYZER_SERVICE_URL="http://127.0.0.1:4310"
ANALYZER_SERVICE_TOKEN=""
ANALYZER_PORT="4310"
ANALYZER_HOST="127.0.0.1"
# Optional worker data root holding uploads/ and jobs/ (default: apps/analyzer/var,
# resolved module-relative, never cwd-relative) — blank is fine.
# ANALYZER_DATA_DIR=""
